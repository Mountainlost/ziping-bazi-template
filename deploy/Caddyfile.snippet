# Merge this site block into the existing Caddy configuration only after backup and caddy validate.
# Replace domain, bcrypt hash, and upstream port. Do not start another Caddy on ports 80/443.
bazi.example.com {
    encode zstd gzip
    basic_auth {
        owner REPLACE_WITH_CADDY_HASH_PASSWORD_OUTPUT
    }
    request_body {
        max_size 64KB
    }
    reverse_proxy 127.0.0.1:18881
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
}
